	let d0 = sr_ground(p);
	let m = g_mat;
	let kind = g_kind;
	// Far off, the reef thins out to nothing, in dots.
	var there = 1.0 - smoothstep(8.5, 11.5, t);
	if (m != 1) {
		there = 1.0 - smoothstep(11.0, 14.0, t);
	}
	if (there <= g_thr) {
		return none;
	}
