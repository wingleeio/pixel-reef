		let b = K_BUD[i];
		let bd = length(p - b) - 0.16;
		if (bd > g_near) {
			d = min(d, bd);
			continue;
		}
		let s = sd_cap(p, b, b + vec3<f32>(0.0, 0.07, 0.0), 0.014, 0.01);
		if (s < d) {
			d = s;
			kind = 8;
			mat = 6;
		}
		let g = length(p - b - vec3<f32>(0.0, 0.09, 0.0)) - 0.03;
		if (g < d) {
			d = g;
			kind = 8;
			mat = 10;
		}
	}
