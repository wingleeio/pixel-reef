{
  "id": "pixel-reef",
  "name": "Pixel Reef",
  "version": "0.1.0",
  "description": "An animated pixel-art underwater scene drawn from gaussian splats: fish, jellyfish, a turtle, a manta, kelp and light rays. Behind a new chat, and dimmed behind your chats.",
